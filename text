      String pledgeNo, String brid) async {
    final data = await _get(
        'IRREGULARITY_VIEW', '$pledgeNo*${FFAppState().cmbStatus}*$brid');
    return data.map((json) {
      String itemName = '';
      json.forEach((k, v) {
        if (k.toString().contains('ITEM_NAME')) itemName = v.toString().trim();
        if (k.toString().contains('RPAD(IM.ITEM_NAME,30)'))
          itemName = v.toString().trim();
      });
      return Result1Struct(
        colItem: itemName,
        colItemid: int.tryParse(json['ITEM_ID']?.toString() ?? '0') ?? 0,
        colCurpurity: json['DEDUCTION_NAME']?.toString() ?? '',
        colDeducrate: int.tryParse(
                json['DEDUCTION_RATE']?.toString().split('~').last ?? '0') ??
            0,
        colAutoloss: '0',
        colDbitemcount:
            int.tryParse(json['ITEM_COUNT']?.toString() ?? '0') ?? 0,
        colTypid: int.tryParse(json['TYPE_ID']?.toString() ?? '0') ?? 0,
        colCgwt: double.tryParse(json['ACT_WT']?.toString() ?? '0') ?? 0.0,
        colCstwt: int.tryParse(json['STONE_WT']?.toString() ?? '0') ?? 0,
        colCntwt: double.tryParse(json['NET_WT']?.toString() ?? '0') ?? 0.0,
