  double remain_netwt(double rgwt, double rstwt) {
    double rnwt = 0.0;
    double nwt = 0.0;
    double dedrate = widget.input.deduRate;

    nwt = ((rgwt - rstwt) * dedrate / 100);

    rnwt = double.parse(((rgwt - rstwt) - nwt).toStringAsFixed(2));

    return rnwt;
  }

