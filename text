                  var item = entry.value;
                  bool isSelected = item['is_selected'] ?? false;
                  String currentPcs = '';
                  String currentGw = '';
                  String currentNet = '';
                  String currentStone = '';
                  String currentLossWt = '';
                  String currentLossAmt = '';
                  if (index < FFAppState().DtviewIrr.length) {
                    final rowState = FFAppState().DtviewIrr[index];
                    currentPcs = rowState.colItemcount ?? '';
                    currentGw = rowState.colGw ?? '';
                    currentNet = rowState.colNetwt ?? '';
                    currentStone = rowState.colStwt ?? '';
                    if (currentStone.isEmpty) {
                      currentLossWt = '';
                      currentLossAmt = '';
                    } else {
                      double netWtD =
                          double.tryParse(rowState.colNetwt ?? '') ?? 0.0;
                      double cntWtD =
                          double.tryParse(rowState.colCurNetwt ?? '0') ?? 0.0;
                      currentLossWt = (cntWtD - netWtD).toStringAsFixed(3);
                      if (currentLossWt == '0.00' || currentLossWt == '0')
                        currentLossWt = '';
                      currentLossAmt = rowState.colEstimatedlossamt ?? '';
                      if (currentLossAmt == '0') currentLossAmt = '';
                    }
                  }
                  return _TableDataRow(
                    itemName: item['ITEM_NAME']?.toString() ?? '-',
                    isSelected: isSelected,
                    onSelectionChanged: (value) =>
                        onSelectionChanged(index, value ?? false),
                    selectedIrregularity: item['selected_irregularity'],
                    irregularityTypes: irregularityTypes,
                    onIrregularityChanged: (newValue) =>
                        onIrregularityChanged(index, newValue),
                    selectedPurity: item['selected_purity'],
                    purityParams: purityParams,
                    onPurityChanged: (newValue) =>
                        onPurityChanged(index, newValue),
                    onItemChanged: (key, value) =>
                        onItemChanged(index, key, value),
                    existingPcs: item['NO_OF_PIECES']?.toString() ?? '-',
                    existingGross: item['GROSS_WT']?.toString() ?? '-',
                    existingNet: item['NET_WT']?.toString() ?? '-',
                    existingStone: item['STONE_WT']?.toString() ?? '-',
                    existingPurity: item['PURITY']?.toString() ?? '-',
                    autoPcs: currentPcs,
                    autoGross: currentGw,
                    autoNet: currentNet,
                    autoStone: currentStone,
                    autoEstmatedLossWt: currentLossWt,
                    autoEstmatedLossAmt: currentLossAmt,
                    onhandleTableChanged: (column, value) =>
                        onhandleTableChanged(index, column, value),
                    onFocusLost: (column, value) =>
                        onFocusLost(index, column, value),
                  );
                }).toList(),
              )
            ],
          ),
        ),
      ),
    );
  }
