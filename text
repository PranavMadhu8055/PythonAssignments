  Future<void> handleDataChange(int columnid, int rowid, String value) async {
    var row = FFAppState().DtviewIrr;
    if (columnid == 0) {
      FFAppState()
          .updateDtviewIrrAtIndex(rowid, (e) => e..colItemwiseuprity = value);
    } else if (columnid == 1) {
      FFAppState().updateDtviewIrrAtIndex(
          rowid,
          (e) => e
            ..colItemcount = value
            ..colStwt = ""
            ..colNetwt = ""
            ..colEstimatedlosswt = ""
            ..colEstimatedlossamt = "");
    } else if (columnid == 2) {
      FFAppState().updateDtviewIrrAtIndex(
          rowid,
          (e) => e
            ..colGw = value
            ..colStwt = ""
            ..colNetwt = ""
            ..colPurity = "0"
            ..colEstimatedlosswt = ""
            ..colEstimatedlossamt = "");
      setState(() {
        if (rowid < _tableItems.length) {
          _tableItems[rowid]['selected_purity'] = null;
        }
      });
    } else if (columnid == 3) {
      FFAppState().updateDtviewIrrAtIndex(rowid, (e) => e..colNetwt = value);
    } else if (columnid == 4) {
      FFAppState().updateDtviewIrrAtIndex(rowid, (e) => e..colStwt = value);
      if (value.isEmpty) {
        FFAppState().updateDtviewIrrAtIndex(
            rowid,
            (e) => e
              ..colNetwt = ""
              ..colEstimatedlosswt = ""
              ..colEstimatedlossamt = "");
      } else {
        final currentRow = FFAppState().DtviewIrr[rowid];
        final gw = double.tryParse(currentRow.colGw ?? '') ?? 0.0;
        final itemCount = double.tryParse(currentRow.colItemcount ?? '') ?? 0.0;
        if (row[rowid].colStwt.isNotEmpty &&
            ["4.0", "23.0", "9.0"].contains(FFAppState().dtstr)) {
          final currentGw = double.tryParse(row[rowid].colGw) ?? 0.0;
          final currentStwt = double.tryParse(row[rowid].colStwt) ?? 0.0;
          final currentDedRate =
              double.tryParse(row[rowid].colDeductionrate) ?? 0.0;
          double netWt = double.parse((((currentGw - currentStwt) -
                  ((currentGw - currentStwt) * currentDedRate / 100))
              .toStringAsFixed(3)));
          final stoneWtPer = (currentStwt / currentGw) * 100;
          if (!row[rowid].colItemid.contains("28")) {
            if (stoneWtPer > 40) {
              netWt = netWt - ((currentGw - currentStwt) * 8 / 100);
            } else if (stoneWtPer > 25) {
              netWt = netWt - ((currentGw - currentStwt) * 5 / 100);
            } else if (stoneWtPer > 10) {
              double stonded = double.parse(
                  ((currentGw - currentStwt) * 2 / 100).toStringAsFixed(3));
              netWt = netWt - stonded;
            } else if (stoneWtPer > 5) {
              netWt = netWt - ((currentGw - currentStwt) * 1 / 100);
            } else {
              netWt = netWt;
            }
          } else {
            if (stoneWtPer > 50) {
              netWt = netWt - ((currentGw - currentStwt) * 5 / 100);
            } else if (stoneWtPer > 25) {
              netWt = netWt - ((currentGw - currentStwt) * 5 / 100);
            } else if (stoneWtPer > 10) {
              double stonded = ((currentGw - currentStwt) * 2 / 100);
              netWt = netWt - stonded;
            } else if (stoneWtPer > 5) {
              netWt = netWt - ((currentGw - currentStwt) * 1 / 100);
            } else {
              netWt = netWt;
            }
          }
          row[rowid].colNetwt = netWt.toStringAsFixed(3);
        }
        if ((currentRow.colGw ?? '').isEmpty ||
            (currentRow.colItemcount ?? '').isEmpty ||
            gw == 0 ||
            itemCount == 0) {
          await alert(
              "Please fill No. of Pieces and Gross Weight and item count before filling stone weight");
          setState(() {
            FFAppState().updateDtviewIrrAtIndex(rowid, (e) => e..colStwt = "");
          });
          return;
        }
      }
    } else if (columnid == 5) {
      FFAppState().updateDtviewIrrAtIndex(rowid, (e) => e..colPurity = value);
      if (row[rowid].colStwt.isNotEmpty) {
        final currentGw = double.tryParse(row[rowid].colGw) ?? 0.0;
        final currentStwt = double.tryParse(row[rowid].colStwt) ?? 0.0;
        double pur = double.parse((double.parse(value.split('-')[1]) /
                double.parse(row[rowid].colPurityrate))
            .toStringAsFixed(3));
        double netWt1 =
            ((((currentGw - currentStwt) * pur) * 1000).floor()) / 1000;
        double netWt = double.parse(netWt1.toStringAsFixed(3));
        final stoneWtPer = (currentStwt / currentGw) * 100;
        if (!row[rowid].colItemid.contains("28")) {
          if (stoneWtPer > 40) {
            netWt = netWt - ((currentGw - currentStwt) * 8 / 100);
          } else if (stoneWtPer > 25) {
            netWt = netWt - ((currentGw - currentStwt) * 5 / 100);
          } else if (stoneWtPer > 10) {
            double stonded = double.parse(
                ((currentGw - currentStwt) * 2 / 100).toStringAsFixed(3));
            netWt = netWt - stonded;
          } else if (stoneWtPer > 5) {
            netWt = netWt - ((currentGw - currentStwt) * 1 / 100);
          } else {
            netWt = netWt;
          }
        } else {
          if (stoneWtPer > 50) {
            netWt = netWt - ((currentGw - currentStwt) * 5 / 100);
          } else if (stoneWtPer > 25) {
            netWt = netWt - ((currentGw - currentStwt) * 5 / 100);
          } else if (stoneWtPer > 10) {
            double stonded = ((currentGw - currentStwt) * 2 / 100);
            netWt = netWt - stonded;
          } else if (stoneWtPer > 5) {
            netWt = netWt - ((currentGw - currentStwt) * 1 / 100);
          } else {
            netWt = netWt;
          }
        }
        row[rowid].colNetwt = netWt.toStringAsFixed(3);
      }
    }

    totGw = 0.0;
    totNet = 0.0;
    totStone = 0.0;
    double totalLossWt = 0.0;
    double totalLossAmt = 0.0;
    for (int i = 0; i < FFAppState().DtviewIrr.length; i++) {
      totGw += double.tryParse(FFAppState().DtviewIrr[i].colGw ?? '') ?? 0.0;
      totNet +=
          double.tryParse(FFAppState().DtviewIrr[i].colNetwt ?? '') ?? 0.0;
      totStone +=
          double.tryParse(FFAppState().DtviewIrr[i].colStwt ?? '') ?? 0.0;
      totalLossWt +=
          double.tryParse(FFAppState().DtviewIrr[i].colEstimatedlosswt ?? '') ??
              0.0;
      totalLossAmt += double.tryParse(
              FFAppState().DtviewIrr[i].colEstimatedlossamt ?? '') ??
          0.0;
      FFAppState().lossWt = totalLossWt;
      FFAppState().loss = totalLossAmt.toStringAsFixed(3);
    }
    setState(() {});
  }

