// ---- Purity & Deduction Utils ----

// Tries "~" second token first (e.g., "...~75"), else falls back to text scanning.
double parsePurityPercent(String purityText) {
  if (purityText.isEmpty) return 0.0;
  final parts = purityText.split('~');
  if (parts.length > 1) {
    final maybe = double.tryParse(parts[1].trim());
    if (maybe != null) return maybe;
  }
  final first = parts.first.trim();
  if (first.startsWith('Purity Above 85')) return 85.0;
  final reg = RegExp(r'(\d+(\.\d+)?)');
  final m = reg.firstMatch(first);
  return m != null ? double.tryParse(m.group(1)!) ?? 0.0 : 0.0;
}

bool skipDeductionByScheme(String scheme) =>
    false; // plug your business rule if needed

bool isStonePurityDeductible(DateTime pledgeDate) {
  final start = DateTime(2013, 2, 8), end = DateTime(2012, 3, 27);
  return pledgeDate.isAfter(start) || pledgeDate.isBefore(end);
}

Future<double> stonePurityDeduction({
  required double spurityPercent,
  required double grwt,
  required double stwt,
  required String itemName,
  required DateTime pledgeDate,
  required ShowMessage showMessage,
  Future<double?> Function(double stonePct, DateTime pledgeDate)?
      stoneDeductionLookup,
}) {
  final g = grwt;
  if (g <= 0) return Future.value(0.0);
  final s = stwt;
  return Future(() async {
    final stonePct = (s / g) * 100.0;
    if (stonePct > 85 && itemName.toUpperCase() == 'RAJPUTI') {
      showMessage('Rajaputi item stone >85% not allowed (Circular 5459)');
    } else if (stonePct > 60 && itemName.toUpperCase() != 'RAJPUTI') {
      showMessage('Items stone >50% not allowed (Circular 4304)');
    }
    double? dedExtra;
    if (stoneDeductionLookup != null)
      dedExtra = await stoneDeductionLookup(stonePct, pledgeDate);

    double totalDed = 0.0;
    if (dedExtra != null) {
      double extra = dedExtra;
      if (stonePct > 60 &&
          stonePct <= 85 &&
          itemName.toUpperCase() == 'RAJPUTI') extra = 5.0;
      totalDed = max(0.0, spurityPercent + extra);
    } else {
      // VB Logic: If no stone deduction rule found, deduction (including purity) is reset to 0.
      totalDed = 0.0;
    }

    final netGold = max(0.0, g - s);
    final sntwt = (netGold - (netGold * totalDed / 100.0));
    return sntwt <= 0 ? 0.0 : double.parse(sntwt.toStringAsFixed(2));
  });
}

Future<double> alcStonePurityDeduction({
  required double ntwt,
  required double grwt,
  required double stwt,
  required String itemName,
  required DateTime pledgeDate,
  required ShowMessage showMessage,
  Future<double?> Function(double stonePct, DateTime pledgeDate)?
      stoneDeductionLookup,
}) {
  final g = grwt;
  if (g <= 0) return Future.value(0.0);
  final s = stwt;
  return Future(() async {
    final stonePct = (s / g) * 100.0;
    if (stonePct > 85 && itemName.toUpperCase() == 'RAJPUTI') {
      showMessage('Rajaputi item stone >85% not allowed (Circular 5459)');
    } else if (stonePct > 60 && itemName.toUpperCase() != 'RAJPUTI') {
      showMessage('Items stone >50% not allowed (Circular 4304)');
    }
    double? dedExtra;
    if (stoneDeductionLookup != null)
      dedExtra = await stoneDeductionLookup(stonePct, pledgeDate);

    double dedVal = 0.0;
    if (dedExtra != null) {
      if (stonePct > 60 &&
          stonePct <= 85 &&
          itemName.toUpperCase() == 'RAJPUTI') {
        dedVal = 5.0;
      } else {
        dedVal = dedExtra;
      }
    } else {
      dedVal = 0.0;
    }

    final netGold = max(0.0, g - s);
    final stoneDed = netGold * (max(0.0, dedVal) / 100.0);
    final val = ntwt - double.parse(stoneDed.toStringAsFixed(2));
    return val <= 0 ? 0.0 : double.parse(val.toStringAsFixed(2));
  });
}

// ---- Core Handler: port of.DtviewIrr_CellEndEdit ----
Future<void> onCellEditEnd({
  required AuditState state,
  required int rowIndex,
  required int columnIndex,
  required ShowMessage showMessage,
  required OpenAlcForm openAlcForm,
  Future<double?> Function(double stonePct, DateTime pledgeDate)?
      stoneDeductionLookup,
  int brid = 0,
  String pledgeNo = '',
}) async {
  // print("Cell Edit End - Row: $rowIndex, Column: $columnIndex");
  if (FFAppState().DtviewIrr.isEmpty ||
      rowIndex < 0 ||
      rowIndex >= FFAppState().DtviewIrr.length) return;
  final row = FFAppState().DtviewIrr[rowIndex];

  // Helper to parse purity string for header value (e.g. 75 from Purity-75...)
  // Replicates VB Logic: spurity = ppurity(0).Split("-") ...
  double getHeaderPurity(String purityText) {
    if (purityText.isEmpty) return 0.0;
    List<String> parts = purityText.split('~');
    String header = parts[0];

    // Initial split by '-' as per VB: Dim spurity() As String = ppurity(0).Split("-")
    List<String> spurity = header.split('-');

    if (header == "Purity Above 85(Above 20.5-ct)") {
      // VB: spurity = ppurity(0).Split("(") ... Substring(13, 2)
      if (header.length >= 15) {
        return double.tryParse(header.substring(13, 15)) ?? 0.0;
      }
    } else if (header == "Purity-70(18-ct)" ||
        header == "Purity-75-(19-ct)" ||
        header == "Purity-70-(17-ct)" ||
        header == "Purity-75-(18-ct)" ||
        header == "Purity-79-(19-ct)" ||
        header == "Purity-83-(20-ct)" ||
        header == "Purity-87-(21-ct)" ||
        header == "Purity-91.6-Above(22-ct)" ||
        header == "Purity-80(20-ct)" ||
        header == "Purity-85(20.5-ct)") {
      // VB: spurity = ppurity(0).Split("(") ... spurity = spurity(0).Split("-")
      List<String> temp = header.split('(');
      spurity = temp[0].split('-');
    } else if (spurity.length != 2) {
      // VB: ElseIf spurity.Length <> 2 Then spurity = spurity(0).Split("-")
      if (spurity.isNotEmpty) {
        spurity = spurity[0].split('-');
      }
    }

    // VB: If (spurity.Length = 1) Then spurity = ppurity(0).Split("=")
    if (spurity.length == 1) {
      spurity = header.split('=');
    }

    if (spurity.length > 1) {
      // VB: Int32.Parse(spurity(1))
      return double.tryParse(spurity[1]) ?? 0.0;
    }
    return 0.0;
  }

  // Local function to recompute totals and loss matching VB logic
  void recomputeTotalsAndLoss() {
    double stoneSum = 0, gwSum = 0, ntSum = 0;
    final rate = state.lendRate;
    final pledgeBal = state.pledgeBalance;
    final totLoanValue = state.netweight * rate;
    int totilv = 0, totialv = 0;

    for (final r in FFAppState().DtviewIrr) {
      double rSt = double.tryParse(r.colStwt ?? '0') ?? 0.0;
      double rGw = double.tryParse(r.colGw ?? '0') ?? 0.0;
      double rNt = double.tryParse(r.colNetwt ?? '0') ?? 0.0;
      double rCnt = r.colCntwt ?? 0.0;

      stoneSum += rSt;
      gwSum += rGw;
      ntSum += rNt;

      int ilv = 0;
      int ialv = 0;

      // Logic for Loan Values
      // Zero Spurious
      if ([36, 37, 38].contains(FFAppState().cmbStatus)) {
        // iloanvalue(i) = Math.Round(CDec(Math.Round.DtviewIrr.Rows(i).Cells("col_cntwt").Value * lnd_rate, 2)), MidpointRounding.AwayFromZero)
        double raw = rCnt * rate;
        // Dart round() is closest integer.
        // To match VB Math.Round(x, 2), we can use toStringAsFixed(2).
        double rounded2 = double.parse(raw.toStringAsFixed(2));
        ilv = rounded2.round();

        // iauloanvalue(i) = Math.Round.DtviewIrr.Rows(i).Cells("col_netwt").Value * lnd_rate, 0)
        ialv = (rNt * rate).round();

        r.colAutoloss = (ilv - ialv).toString();
      }
      // Low Quality / Spurious
      else if ([5, 20, 6, 29, 30, 12, 13, 27, 28, 2]
              .contains(FFAppState().cmbStatus) ||
          (FFAppState().cmbStatus == 1 && FFAppState().cmbStatus2 == 0)) {
        // iloanvalue(i) = Math.Round.DtviewIrr.Rows(i).Cells("col_cntwt").Value * lnd_rate, 0)
        ilv = (rCnt * rate).round();
        // iauloanvalue(i) = Math.Round.DtviewIrr.Rows(i).Cells("col_netwt").Value * lnd_rate, 0)
        ialv = (rNt * rate).round();

        r.colAutoloss = (ilv - ialv).toString();
      }

      if (ilv != 0) {
        totilv += ilv;
        totialv += ialv;
      }
    }

    double totalStone = double.parse(stoneSum.toStringAsFixed(3));
    double totalGw = double.parse(gwSum.toStringAsFixed(3));
    double totalNetWt = double.parse(ntSum.toStringAsFixed(3));

    // Calculate Final Loss
    double finalLoss = 0.0;

    if (FFAppState().cmbStatus == 4) {
      // Partial Missing
      // VB: txt_loss.Text = Int32.Parse(txt_loss.Text) + ((CDbl(txt_totgw.Text) - CDbl(txt_totstone.Text)) * rt)
      finalLoss = (gwSum - stoneSum) * state.marketRate;
    } else if ([36, 37, 38].contains(FFAppState().cmbStatus)) {
      // Zero Spurious
      int aalv = (totLoanValue - totilv).round();
      int adjustedAalv = (aalv == -1) ? 0 : aalv;
      int totaalv = adjustedAalv + totialv;

      double rawLoss = pledgeBal - totaalv.toDouble();
      finalLoss = (rawLoss <= -1) ? 0.0 : rawLoss;
    } else if ([5, 20, 6, 29, 30, 12, 13, 27, 28, 2]
            .contains(FFAppState().cmbStatus) ||
        (FFAppState().cmbStatus == 1 && FFAppState().cmbStatus2 == 0)) {
      int aalv = (totLoanValue - totilv).round();
      int totaalv = aalv + totialv;
      if (pledgeBal > totaalv) {
        finalLoss = (pledgeBal - totaalv).toDouble();
      } else {
        finalLoss = 0.0;
      }
    }

    FFAppState().update(() {
      FFAppState().totalNetWtVar = totalNetWt;
      FFAppState().totalGwVar = totalGw;
      FFAppState().totalStoneVar = totalStone;
      FFAppState().txtLoss = finalLoss;
    });
  }

  // Logic for Purity/Row Calculation (Matches VB Column 8 Logic)
  Future<void> recalculateRow() async {
    String purityStr = row.colPurity ?? '';
    if (purityStr.isEmpty) return;

    // Parse purity value (after ~)
    double purityVal = 0.0;
    List<String> parts = purityStr.split('~');
    if (parts.length > 1) {
      purityVal = double.tryParse(parts[1]) ?? 0.0;
    }

    // Calculate Estimate
    double estimate = 0.0;
    if (purityVal >= 20 && purityVal <= 65) {
      estimate = (100 - ((purityVal / 87) * 100)).roundToDouble();
    } else if (purityVal == 100) {
      estimate = purityVal;
    } else {
      estimate = purityVal;
      // SkipDeduction check (assuming false for now as per context)
      // bool skip = false;
      // estimate = skip ? 0.0 : purityVal;
    }

    row.colEstimat = estimate.toString();

    // Calculate Net Weight
    double gw = double.tryParse(row.colGw ?? '0') ?? 0.0;
    double st = double.tryParse(row.colStwt ?? '0') ?? 0.0;

    // clnt = ((GW - SW) * IIf(Est/100 = 0, 1, Est/100))
    double estFactor = (estimate / 100 == 0) ? 1.0 : (estimate / 100);
    double clnt = (gw - st) * estFactor;

    if (estimate == 0) {
      row.colNetwt = double.parse(clnt.toStringAsFixed(2)).toString();
    } else {
      // Stone Deduction Check
      if (isStonePurityDeductible(state.pledgeDate) &&
          st > 0 &&
          estimate != 100.0) {
        // VB: If Int32.Parse(spurity(1)) > 70 Then...
        double headerPurity = getHeaderPurity(purityStr);
        double valForDeduction = (headerPurity > 70) ? purityVal : estimate;

        double net = await stonePurityDeduction(
          spurityPercent: valForDeduction,
          grwt: gw,
          stwt: st,
          itemName: row.colItem ?? '',
          pledgeDate: state.pledgeDate,
          showMessage: showMessage,
          stoneDeductionLookup: stoneDeductionLookup,
        );
        row.colNetwt = net.toString();
        showMessage('Stone-wise Purity Deduction calculated');
      } else {
        // NetWt = Math.Round(((GW - SW) - clnt), 2)
        row.colNetwt =
            double.parse(((gw - st) - clnt).toStringAsFixed(2)).toString();
      }
    }
  }

  // Main Logic Switch
  if (columnIndex > 2) {
    if (columnIndex == 8) {
      // Purity Column

      if ((row.colPurity ?? '').isEmpty) {
        showMessage("Pls select Purity");
        return;
      }
      await recalculateRow();
      recomputeTotalsAndLoss();
    } else if (columnIndex == 5 || columnIndex == 3) {
      // Stone or GW
      // Ensure row net weight is updated when GW/Stone changes (Implicit in VB via loop, explicit here)
      await recalculateRow();
      recomputeTotalsAndLoss();

      // Partial Missing Logic
      if (FFAppState().cmbStatus == 4 && columnIndex == 5) {
        row.colNetwt = '0';
        recomputeTotalsAndLoss(); // Recalculate loss with new totals
      }
    }
  } else {
    // ALC Trigger Logic (Checkbox or similar)
    bool isChecked = row.colStatus ?? false;
    int s = FFAppState().cmbStatus;
    int s1 = FFAppState().cmbStatus2;

    bool alcCondition = isChecked &&
        s1 != 1 &&
        s1 > 0 &&
        [5, 6, 29, 30, 31, 12, 13, 27, 28, 2, 38].contains(s);

    if (alcCondition) {
      // Open ALC Form
      final res = await openAlcForm(AlcInput(
        itemName: row.colItem ?? '',
        deduRate: row.colDeducrate.toDouble(),
        dbItemCount: row.colDbitemcount ?? 0,
        itemId: row.colItemid ?? 0,
        brid: brid,
        pledgeNo: pledgeNo,
        cgwt: row.colCgwt ?? 0.0,
        cstwt: row.colCstwt.toDouble(),
        statusMain: s,
        cntwt: row.colCntwt ?? 0.0,
        scheme: state.scheme,
        pledgeDate: state.pledgeDate,
        statusSub: s1,
        typeId: row.colTypid ?? 0,
        curPurity: row.colCurpurity ?? '',
        itemType: '', // Not in struct, pass empty or lookup
        lendRate: state.lendRate,
      ));

      if (res != null) {
        if (res.tGrwt > (row.colCgwt ?? 0.0)) {
          showMessage(
              "Calculated Item Weight Exceeds Actual Gross Weight. Please Calculate Again");
          // Reset row
          row.colStatus = false;
          row.colItemcount = '';
          row.colGw = '';
          row.colStwt = '';
          row.colNetwt = '';
          row.colSubrecord = '';
          return;
        }

        row.colItemcount = (row.colDbitemcount ?? 0).toString();
        row.colGw = res.tGrwt.toString();
        row.colStwt = res.tStwt.toString();
        row.colNetwt = res.tNtwt.toString();
        row.colSubrecord = res.subrecord;

        // Stone Deduction after ALC return
        if (isStonePurityDeductible(state.pledgeDate) &&
            (double.tryParse(row.colStwt ?? '0') ?? 0.0) > 0) {
          double net = await alcStonePurityDeduction(
            ntwt: double.tryParse(row.colNetwt ?? '0') ?? 0.0,
            grwt: double.tryParse(row.colGw ?? '0') ?? 0.0,
            stwt: double.tryParse(row.colStwt ?? '0') ?? 0.0,
            itemName: row.colItem ?? '',
            pledgeDate: state.pledgeDate,
            showMessage: showMessage,
            stoneDeductionLookup: stoneDeductionLookup,
          );
          row.colNetwt = net.toString();
        }
        recomputeTotalsAndLoss();
      }
    }

    // Weight Difference / Under Stone / Excess Stone
    if (isChecked && [23, 9, 10].contains(s)) {
      final res = await openAlcForm(AlcInput(
        itemName: row.colItem ?? '',
        deduRate: row.colDeducrate.toDouble(),
        dbItemCount: row.colDbitemcount ?? 0,
        itemId: row.colItemid ?? 0,
        brid: brid,
        pledgeNo: pledgeNo,
        cgwt: row.colCgwt ?? 0.0,
        cstwt: row.colCstwt.toDouble(),
        statusMain: s,
        cntwt: row.colCntwt ?? 0.0,
        scheme: state.scheme,
        pledgeDate: state.pledgeDate,
        statusSub: 0,
        typeId: row.colTypid ?? 0,
        curPurity: row.colCurpurity ?? '',
        itemType: '',
        lendRate: state.lendRate,
      ));

      if (res != null) {
        row.colItemcount = (row.colDbitemcount ?? 0).toString();
        row.colGw = res.tGrwt.toString();
        row.colStwt = res.tStwt.toString();
        row.colNetwt = res.tNtwt.toString();
        row.colSubrecord = res.subrecord;

        if (isStonePurityDeductible(state.pledgeDate) &&
            (double.tryParse(row.colStwt ?? '0') ?? 0.0) > 0) {
          double net = await alcStonePurityDeduction(
            ntwt: double.tryParse(row.colNetwt ?? '0') ?? 0.0,
            grwt: double.tryParse(row.colGw ?? '0') ?? 0.0,
            stwt: double.tryParse(row.colStwt ?? '0') ?? 0.0,
            itemName: row.colItem ?? '',
            pledgeDate: state.pledgeDate,
            showMessage: showMessage,
            stoneDeductionLookup: stoneDeductionLookup,
          );
          row.colNetwt = net.toString();
        }
        recomputeTotalsAndLoss();
      }
    }
  }
}

class _NumberCell extends StatefulWidget {
  final double value;
  final ValueChanged<double> onChanged;
  final VoidCallback onSubmitted;
  const _NumberCell(
      {required this.value,
      required this.onChanged,
      required this.onSubmitted});
  @override
  State<_NumberCell> createState() => _NumberCellState();
}

class _NumberCellState extends State<_NumberCell> {
  late TextEditingController _ctrl;
  @override
  void initState() {
    super.initState();
    _ctrl = TextEditingController(
        text: widget.value == 0 ? '' : widget.value.toString());
  }

  @override
  void didUpdateWidget(_NumberCell oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (widget.value != oldWidget.value) {
      final currentVal = double.tryParse(_ctrl.text) ?? 0.0;
      // Only update text if the value actually changed significantly from what's currently typed
      if ((currentVal - widget.value).abs() > 0.0001) {
        _ctrl.text = widget.value == 0 ? '' : widget.value.toString();
        _ctrl.selection = TextSelection.collapsed(offset: _ctrl.text.length);
      }
    }
  }

  @override
  void dispose() {
    _ctrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: 100,
      child: TextField(
        controller: _ctrl,
        keyboardType: TextInputType.number,
        onChanged: (v) => widget.onChanged(double.tryParse(v.trim()) ?? 0.0),
        onSubmitted: (_) => widget.onSubmitted(),
        decoration:
            const InputDecoration(isDense: true, border: OutlineInputBorder()),
      ),
    );
  }
}

