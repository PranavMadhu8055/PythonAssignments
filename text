  Future<void> _loadData() async {
    setState(() => _isLoading = true);

    try {
      final api = ApiService();
      // 1. Fetch Items
      final items = await api.fetchPledgeItems(
          FFAppState().pledgeNumIrr, FFAppState().selectbridIrr);

      // Fetch Item Types
      final itemTypes = await api.fetchItemTypes();
      _itemTypes = itemTypes;

      // 2. Fetch Market Rate
      final mRate = await api.fetchMarketRate();
      // 2b. Fetch Pledge Balance
      final pBal = await api.fetchPledgeBalance(FFAppState().pledgeNumIrr);

      // 2c. Fetch Inventory Details (Lend Rate, Scheme, Date)
      final invDetails = await api.fetchInventoryDetails(
          FFAppState().selectbridIrr, FFAppState().pledgeNumIrr);

      double lRate = 0.0;

      if (invDetails != null) {
        lRate =
            double.tryParse(invDetails['LND_RATE']?.toString() ?? '0') ?? 0.0;
        audit.scheme = invDetails['SCHEME_NM']?.toString() ?? '';
        audit.actweight =
            double.tryParse(invDetails['ACTUAL_GROSS_WT']?.toString() ?? '0') ??
                0.0;
        audit.netweight =
            double.tryParse(invDetails['NET_WEIGHT']?.toString() ?? '0') ?? 0.0;
        final raw = invDetails['PLEDGEDT']?.toString() ?? '';
        print('Raw Pledge Date: $raw');

        if (raw.isNotEmpty) {
          try {
            // 1) Normalize delimiters to '-'
            final dateStr = raw.trim().replaceAll(RegExp(r'[./]'), '-');

            // 2) Split and normalize the month to Title Case to satisfy 'MMM' (en_US)
            final parts = dateStr.split('-');
            if (parts.length != 3) {
              throw FormatException(
                  'Unexpected date shape. Expected dd-MMM-yyyy.');
            }

            // Normalize day (keep as is), month to Title Case, year as is
            final day = parts[0].padLeft(2, '0');
            final monRaw = parts[1];
            final yearRaw = parts[2];

            // Title-case the month token (e.g., feb/FEB -> Feb)
            final month = (monRaw.isEmpty)
                ? monRaw
                : monRaw[0].toUpperCase() + monRaw.substring(1).toLowerCase();

            // If you need to coerce 2-digit years, uncomment and choose a pivot rule
            // String year;
            // if (yearRaw.length == 2) {
            //   final yy = int.parse(yearRaw);
            //   // Pivot: 00-79 -> 2000-2079, 80-99 -> 1980-1999 (example)
            //   year = (yy <= 79 ? 2000 + yy : 1900 + yy).toString();
            // } else {
            //   year = yearRaw;
            // }
            final year =
                yearRaw; // keep as provided (expects 4 digits for parseStrict)

            final normalized = '$day-$month-$year';
            // 3) Parse strictly with en_US month names
            final df = DateFormat('dd-MMM-yyyy', 'en_US');
            audit.pledgeDate = df.parseStrict(normalized);

            print('Parsed Pledge Date: ${audit.pledgeDate}');
          } catch (e) {
            debugPrint('Date parse error: $e');
          }
        }
      } else {
        lRate = await api.fetchLendRate(FFAppState().pledgeNumIrr);
      }

      // 3. Fetch Purity Options
      _purityOptionsList.clear();
      final typeCache = <int, List<String>>{};
      for (final item in items) {
        final typeId = item.colTypid ?? 0;
        if (!typeCache.containsKey(typeId)) {
          typeCache[typeId] = await api.fetchPurityParams(
              FFAppState().pledgeNumIrr,
              FFAppState().selectbridIrr,
              typeId,
              audit.scheme,
              audit.pledgeDate);
        }
        final options = typeCache[typeId] ?? [];
        _purityOptionsList.add(options);

        String purityText = item.colPurity ?? '';
        if (purityText.isNotEmpty && options.isNotEmpty) {
          if (!options.contains(purityText)) {
            final match = options.firstWhere(
              (opt) => opt.startsWith(purityText),
              orElse: () => '',
            );
            if (match.isNotEmpty) item.colPurity = match;
          }
        }
      }

      // 4. Fetch Status Options
      final statuses =
          await api.fetchStatusOptions(FFAppState().selectbridIrr, 90);
      // print(statuses);
      setState(() {
        FFAppState().DtviewIrr = items;
        // print(FFAppState().DtviewIrr);
        // audit.totalNetWtDb =
        //     items.fold(0.0, (sum, r) => sum + (r.colCntwt ?? 0.0));
        audit.marketRate = mRate;
        audit.lendRate = lRate;
        audit.pledgeBalance = pBal;
        _statusOptions = statuses;

        if (!_statusOptions.containsKey(FFAppState().cmbStatus)) {
          if (_statusOptions.containsKey(0))
            FFAppState().cmbStatus = 0;
          else if (_statusOptions.isNotEmpty)
            FFAppState().cmbStatus = _statusOptions.keys.first;
        }
      });
      _recalculateTotals();
    } finally {
      setState(() => _isLoading = false);
    }
  }

