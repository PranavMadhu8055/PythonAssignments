  void _recalculate() {
    final rows = FFAppState().Dtview;
    final double lndRate = (audit.lendRate ?? 0).toDouble();
    final double pBal = (audit.pledgeBalance ?? 0).toDouble();
    double stoneSum = 0.0;
    double gwSum = 0.0;
    double ntSum = 0.0;
    int totilv = 0;
    int totialv = 0;
    for (var i = 0; i < rows.length; i++) {
      final r = rows[i];
      final double st = double.tryParse(r.colStwt ?? '') ?? 0.0;
      final double gw = double.tryParse(r.colGw ?? '') ?? 0.0;
      final double net = double.tryParse(r.colNetwt ?? '') ?? 0.0;
      final double cnt = (r.colCntwt ?? 0.0).toDouble();
      stoneSum += st;
      gwSum += gw;
      ntSum += net;
      final int ilv = (cnt * lndRate).round();
      final int ialv = (net * lndRate).round();
      totilv += ilv;
      totialv += ialv;
      r.colAutoloss = (ilv - ialv).toString();
    }
    FFAppState().totalStoneVar = double.parse(stoneSum.toStringAsFixed(3));
    FFAppState().totalGwVar = gwSum;
    FFAppState().totalNetWtVar = double.parse(ntSum.toStringAsFixed(3));
    final int totLoanValue = (audit.netweight * lndRate).round();
    final int aalv = totLoanValue - totilv;
    final int totaalv = aalv + totialv;
    final double loss = (pBal > totaalv) ? (pBal - totaalv) : 0.0;
    FFAppState().update(() {
      FFAppState().txtLoss = loss;
    });
  }

  void _recalculateTotals() {
    double stoneSum = 0, gwSum = 0, ntSum = 0;
    int totilv = 0, totialv = 0;
    double totLoanValue = audit.netweight * audit.lendRate;
    for (final r in FFAppState().Dtview) {
      double st = double.tryParse(r.colStwt ?? '0') ?? 0.0;
      double gw = double.tryParse(r.colGw ?? '0') ?? 0.0;
      double nt = double.tryParse(r.colNetwt ?? '0') ?? 0.0;
      double cnt = r.colCntwt ?? 0.0;
      stoneSum += st;
      gwSum += gw;
      ntSum += nt;
      if (cnt > 0 && nt >= 0) {
        int ilv = 0;
        int ialv = 0;
        if ([36, 37, 38].contains(FFAppState().cmbStatus)) {
          double rawIlv = cnt * audit.lendRate;
          double rounded2 = double.parse(rawIlv.toStringAsFixed(2));
          ilv = rounded2.round();
          ialv = (nt * audit.lendRate).round();
        } else {
          ilv = (cnt * audit.lendRate).round();
          ialv = (nt * audit.lendRate).round();
        }
        r.colAutoloss = (ilv - ialv).toString();
        totilv += ilv;
        totialv += ialv;
      }
    }
    double totalStone = double.parse(stoneSum.toStringAsFixed(3));
    double totalGw = double.parse(gwSum.toStringAsFixed(3));
    double totalNetWt = double.parse(ntSum.toStringAsFixed(3));
    double finalLoss = _calculateLossFromTotals(
        totLoanValue, totilv, totialv, totalGw, totalStone);
    FFAppState().update(() {
      FFAppState().totalNetWtVar = double.parse(totalNetWt.toStringAsFixed(2));
      FFAppState().totalGwVar = totalGw;
      FFAppState().totalStoneVar = totalStone;
      FFAppState().txtLoss = finalLoss;
    });
  }

  double _calculateLossFromTotals(double totLoanValue, int totilv, int totialv,
      double totalGw, double totalStone) {
    double loss = 0.0;
    if (FFAppState().cmbStatus == 4) {
      loss = ((totalGw - totalStone) * audit.marketRate).roundToDouble();
    } else if ([36, 37, 38].contains(FFAppState().cmbStatus)) {
      final aalv = (totLoanValue - totilv).round();
      final adjustedAalv = (aalv == -1) ? 0 : aalv;
      final totaalv = adjustedAalv + totialv;
      double rawLoss = audit.pledgeBalance - totaalv.toDouble();
      loss = (rawLoss <= -1) ? 0 : rawLoss;
    } else if ([5, 20, 6, 29, 30, 12, 13, 27, 28, 2, 1]
            .contains(FFAppState().cmbStatus) &&
        FFAppState().cmbStatus2 == 0) {
      final aalv = (totLoanValue - totilv).round();
      final totaalv = aalv + totialv;
      loss = (audit.pledgeBalance > totaalv)
          ? (audit.pledgeBalance - totaalv).toDouble()
          : 0.0;
    }
    return loss;
  }

  bool _isStonePurity_Deductible() {
    final dt = DateTime(2013, 2, 8);
    final dt1 = DateTime(2012, 3, 27);
    return audit.pledgeDate.isAfter(dt) || audit.pledgeDate.isBefore(dt1);
  }

  Future<String> _stonePurityDeduction(
      String spurity, String grwt, String stwt, String itemname) async {
    double ded = double.tryParse(spurity) ?? 0.0;
    double g = double.tryParse(grwt) ?? 0;
    double s = double.tryParse(stwt) ?? 0;
    if (g <= 0) return "0";
    double net = g - s;
    double stone = (s / g) * 100;
    if (stone > 85 && itemname.toUpperCase() == "RAJPUTI") {
      _showMessage(
          "Rajaputi Item with stone weight greater than 85% of gross weight is not allowed. Ref : Circular : 5459");
    } else if (stone > 60 && itemname.toUpperCase() != "RAJPUTI") {
      _showMessage(
          "Items with stone weight greater than 50% of gross weight is not allowed. Ref : Circular : 4304");
    }
    double totalDed;
    double? apiDed =
        await ApiService().fetchStoneDeduction(audit.pledgeDate, stone);

    if (apiDed != null) {
      double extraDed = apiDed;
      if (stone > 60 && stone <= 85 && itemname.toUpperCase() == "RAJPUTI") {
        extraDed = 5.0;
      }
      totalDed = ded + extraDed;
    } else {
      totalDed = 0.0;
    }
    double sntwt = net - (net * totalDed / 100);
    double roundedSntwt = double.parse(sntwt.toStringAsFixed(2));
    return roundedSntwt < 0 ? "0" : roundedSntwt.toString();
  }

  Future<String> _alcStonePurityDeduction(
      String ntwt, String grwt, String stwt, String itemname) async {
    double g = double.tryParse(grwt) ?? 0;
    double s = double.tryParse(stwt) ?? 0;
    if (g <= 0) return ntwt;
    double net = g - s;
    double stone = (s / g) * 100;
    if (stone > 85 && itemname.toUpperCase() == "RAJPUTI") {
      _showMessage(
          "Rajaputi Item with stone weight greater than 85% of gross weight is not allowed. Ref : Circular : 5459");
    } else if (stone > 60 && itemname.toUpperCase() != "RAJPUTI") {
      _showMessage(
          "Items with stone weight greater than 50% of gross weight is not allowed. Ref : Circular : 4304");
    }
    double ded = 0.0;
    double? apiDed =
        await ApiService().fetchStoneDeduction(audit.pledgeDate, stone);

    if (apiDed != null) {
      if (stone > 60 && stone <= 85 && itemname.toUpperCase() == "RAJPUTI") {
        ded = 5.0;
      } else {
        ded = apiDed;
      }
    }
    double deductionAmount = double.parse((net * ded / 100).toStringAsFixed(2));
    double currentNtwt = double.tryParse(ntwt) ?? 0;
    double sntwt =
        double.parse((currentNtwt - deductionAmount).toStringAsFixed(2));
    return sntwt < 0 ? "0" : sntwt.toString();
  }

