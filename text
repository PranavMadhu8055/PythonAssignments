  double remain_netwt(double rgwt, double rstwt) {
    double nwt = ((rgwt - rstwt) * widget.input.deduRate / 100);
    return double.parse(((rgwt - rstwt) - nwt).toStringAsFixed(2));
  }

  Future<void> _showAlert(String message) async {
