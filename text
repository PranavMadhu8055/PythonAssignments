  final start = DateTime(2013, 2, 8), end = DateTime(2012, 3, 27);
  return pledgeDate.isAfter(start) || pledgeDate.isBefore(end);
}

Future<double> stonePurityDeduction({
  required double spurityPercent,
  required double grwt,
  required double stwt,
  required String itemName,
  required DateTime pledgeDate,
  required ShowMessage showMessage,
  Future<double?> Function(double stonePct, DateTime pledgeDate)?
      stoneDeductionLookup,
}) {
  final g = grwt;
  if (g <= 0) return Future.value(0.0);
  final s = stwt;
  return Future(() async {
    final stonePct = (s / g) * 100.0;
    if (stonePct > 85 && itemName.toUpperCase() == 'RAJPUTI') {
      showMessage('Rajaputi item stone >85% not allowed (Circular 5459)');
    } else if (stonePct > 60 && itemName.toUpperCase() != 'RAJPUTI') {
      showMessage('Items stone >50% not allowed (Circular 4304)');
    }
    double? dedExtra;
    if (stoneDeductionLookup != null) {
      dedExtra = await stoneDeductionLookup(stonePct, pledgeDate);
    }
    double totalDed = 0.0;
    if (dedExtra != null) {
      double extra = dedExtra;
      if (stonePct > 60 &&
          stonePct <= 85 &&
          itemName.toUpperCase() == 'RAJPUTI') extra = 5.0;
      totalDed = max(0.0, spurityPercent + extra);
    }
    final netGold = max(0.0, g - s);
    final sntwt = (netGold - (netGold * totalDed / 100.0));
    return sntwt <= 0 ? 0.0 : double.parse(sntwt.toStringAsFixed(2));
  });
}

Future<double> alcStonePurityDeduction({
  required double ntwt,
  required double grwt,
  required double stwt,
  required String itemName,
  required DateTime pledgeDate,
  required ShowMessage showMessage,
  Future<double?> Function(double stonePct, DateTime pledgeDate)?
      stoneDeductionLookup,
}) {
  final g = grwt;
  if (g <= 0) return Future.value(0.0);
  final s = stwt;
  return Future(() async {
    final stonePct = (s / g) * 100.0;
    if (stonePct > 85 && itemName.toUpperCase() == 'RAJPUTI') {
      showMessage('Rajaputi item stone >85% not allowed (Circular 5459)');
    } else if (stonePct > 60 && itemName.toUpperCase() != 'RAJPUTI') {
      showMessage('Items stone >50% not allowed (Circular 4304)');
    }
    double? dedExtra;
    if (stoneDeductionLookup != null) {
      dedExtra = await stoneDeductionLookup(stonePct, pledgeDate);
    }
    double dedVal = 0.0;
    if (dedExtra != null) {
      if (stonePct > 60 &&
          stonePct <= 85 &&
          itemName.toUpperCase() == 'RAJPUTI') {
        dedVal = 5.0;
      } else {
        dedVal = dedExtra;
      }
    }
    final netGold = max(0.0, g - s);
    final stoneDed = netGold * (max(0.0, dedVal) / 100.0);
    final val = ntwt - double.parse(stoneDed.toStringAsFixed(2));
    return val <= 0 ? 0.0 : double.parse(val.toStringAsFixed(2));
  });
}

class _NumberCell extends StatefulWidget {
  final double value;
  final ValueChanged<double> onChanged;
  final VoidCallback onSubmitted;

  const _NumberCell({
    required this.value,
    required this.onChanged,
    required this.onSubmitted,
  });

  @override
  State<_NumberCell> createState() => _NumberCellState();
}

class _NumberCellState extends State<_NumberCell> {
  late TextEditingController _ctrl;

  @override
  void initState() {
    super.initState();
    _ctrl = TextEditingController(
        text: widget.value == 0 ? '' : widget.value.toString());
  }

  @override
  void didUpdateWidget(_NumberCell oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (widget.value != oldWidget.value) {
      final currentVal = double.tryParse(_ctrl.text) ?? 0.0;
      if ((currentVal - widget.value).abs() > 0.0001) {
        _ctrl.text = widget.value == 0 ? '' : widget.value.toString();
        _ctrl.selection = TextSelection.collapsed(offset: _ctrl.text.length);
      }
    }
  }

  @override
  void dispose() {
    _ctrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: 100,
      child: TextField(
        controller: _ctrl,
        keyboardType: TextInputType.number,
        onChanged: (v) => widget.onChanged(double.tryParse(v.trim()) ?? 0.0),
        onSubmitted: (_) => widget.onSubmitted(),
        decoration:
            const InputDecoration(isDense: true, border: OutlineInputBorder()),
      ),
    );
  }
}

class ApiService {
  static String baseUrl = FFDevEnvironmentValues().Baseurl +
      '/AuditInspectionApi/api/GetInspectionData';
  String token = FFAppState().Token;
  Future<List<dynamic>> _get(String flag, String params) async {
    final url = Uri.parse('$baseUrl/$flag/$params/1');
    try {
      final response = await http.get(
        url,
        headers: {'Authorization': 'Bearer $token'},
      );
      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        if (data is Map && data.containsKey('result')) {
          return data['result'] as List<dynamic>;
        }
      } else {
        debugPrint('API Error ${response.statusCode}: ${response.body}');
      }
    } catch (e) {
      debugPrint('API Exception: $e');
    }
    return [];
  }

