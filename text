  Future<Map<int, String>> fetchStatusOptions(String brid, int stflg) async {
    final data = await _get('STATEID_CHECK', '$brid*$stflg');
    final options = <int, String>{};
    for (final item in data) {
      // Try to find keys if they differ, or fallback to values
      var id;
      var name;

      if (item is Map) {
        // Iterate keys to find the numeric ID and the text description
        for (var key in item.keys) {
          if (key == '0' || key == 'STATUS_ID') id = item[key];
          if (key == "'-------SELECT---------'" || key == 'STATUS_NAME')
            name = item[key];
        }
        // Fallback if specific keys not found: use first value as ID, second as Name
        if (id == null && item.values.isNotEmpty) {
          final vals = item.values.toList();
          if (vals.isNotEmpty) id = vals[0];
          if (vals.length > 1) name = vals[1];
        }
      }

      if (id != null && name != null) {
        final parsedId = double.tryParse(id.toString())?.toInt();
        if (parsedId != null) {
          options[parsedId] = name.toString();
        }
      }
    }
    return options;
  }

