  /// Extracts the numeric purity value from the text part of a purity string.
  /// e.g., "Purity-70(18-ct)" -> 70.0
  /// This replicates the complex parsing logic from the VB `getsubRecord` function.
  double _getNumericPurityFromHeaderText(String purityText) {
    if (purityText.isEmpty) return 0.0;

    List<String> purity = purityText.split('~');
    if (purity.isEmpty) return 0.0;

    final header = purity[0];
    List<String> spurity = [];

    if (header == "Purity Above 85(Above 20.5-ct)") {
      spurity = header.split('(');
      if (header.length >= 15) {
        spurity.add(header.substring(13, 15));
      } else {
        spurity.add("85");
      }
    } else if (header == "Purity-70(18-ct)" ||
        header == "Purity-75(19-ct)" ||
        header == "Purity-80(20-ct)" ||
        header == "Purity-85(20.5-ct)") {
      spurity = header.split('(')[0].split('-');
    } else if (header.startsWith("Purity>=")) {
      spurity = header.split('=');
    } else {
      spurity = header.split('-');
      if (spurity.length == 1) {
        spurity = header.split('=');
      }
    }

    if (spurity.length > 1) {
      return double.tryParse(spurity[1].replaceAll(')', '').trim()) ?? 0.0;
    }

    // This case is for fallbacks where the split might result in a single value
    // that is the number itself, or parsing fails.
    return 0.0;
  }

  Future<void> _autoCalculate() async {
    await _recalculate();

    double currentGwSum = 0.0;
    double currentStSum = 0.0;
    double currentNetSum = 0.0;

    for (var row in _rows) {
      if (row.purityText.isNotEmpty && row.purityText.contains('~')) {
        currentGwSum += row.gw;
        currentStSum += row.stwt;
        currentNetSum += row.netwt;
      }
    }

    double remGw = widget.input.cgwt - currentGwSum;
    double remSt = widget.input.cstwt - currentStSum;
    double extraNet = remain_netwt(remGw, remSt);

    setState(() {
      _totGw = widget.input.cgwt;
      _totStwt = widget.input.cstwt;
      _totNetwt = currentNetSum + extraNet;
    });

    _showAlert("Auto Calculated. Remaining Net Added: $extraNet");
  }

  Future<void> _recalculate() async {
    double gwSum = 0.0;
    double stSum = 0.0;
    double netSum = 0.0;

    // Iterate over a copy to avoid concurrent modification issues if rows are deleted during async
    final rowsCopy = List<AlcRow>.from(_rows);
    for (var row in rowsCopy) {
      if (row.purityText.isEmpty || !row.purityText.contains('~')) {
        row.netwt = 0.0;
        row.estimate = 0.0;
        row.autoLoss = 0.0;
        continue;
      }

      List<String> purity = row.purityText.split('~');
      double purityVal =
          (purity.length > 1) ? (double.tryParse(purity[1]) ?? 0.0) : 0.0;

      if (purityVal >= 20 && purityVal <= 65) {
        //.DtviewIrr1.Rows(i).Cells("col_estimat").Value = Math.Round(100 - ((purity(1) / 87) * 100), 0)
        row.estimate = (100 - ((purityVal / 87) * 100)).roundToDouble();
      } else if (purityVal == 100) {
        // ElseIf purity(1) = 100 Then
        row.estimate = purityVal;
      } else {
        // Else ... SkipDeduction logic ...
        row.estimate = purityVal;
      }

      // clnt = (.DtviewIrr1.Rows(i).Cells("col_gw").Value -.DtviewIrr1.Rows(i).Cells("col_stwt").Value) * IIf.DtviewIrr1.Rows(i).Cells("col_estimat").Value / 100 = 0, 1,.DtviewIrr1.Rows(i).Cells("col_estimat").Value / 100))
      double factor = (row.estimate / 100 == 0) ? 1.0 : (row.estimate / 100);
      double clnt = ((row.gw - row.stwt) * factor);

      // If.DtviewIrr1.Rows(i).Cells("col_estimat").Value = 0 Then
      if (row.estimate == 0) {
        row.netwt = double.parse(clnt.toStringAsFixed(2));
      } else {
        // VB Logic: Else.DtviewIrr1.Rows(i).Cells("col_netwt").Value = Math.Round((.DtviewIrr1.Rows(i).Cells("col_gw").Value -.DtviewIrr1.Rows(i).Cells("col_stwt").Value) - clnt), 2)
        row.netwt =
            double.parse(((row.gw - row.stwt) - clnt).toStringAsFixed(2));
      }

      if (row.netwt < 0) {
        row.netwt = 0;
        await _showAlert("Net weight cannot be negative");
      }

      // Auto Loss Calculation
      double ilv = (row.cntwt * widget.input.lendRate).roundToDouble();
      double ialv = (row.netwt * widget.input.lendRate).roundToDouble();
      row.autoLoss = ilv - ialv;
    }

    // Calculate totals based on current _rows (in case rows were removed)
    for (var row in _rows) {
      gwSum += row.gw;
      stSum += row.stwt;
      netSum += row.netwt;
    }

    setState(() {
      _totGw = gwSum;
      _totStwt = stSum;
      _totNetwt = netSum;
    });
  }

  Future<void> _onItemCountChanged(AlcRow row, String value) async {
    int val = int.tryParse(value) ?? 0;
    row.itemCount = val;

    // VB Logic: Check total count and auto-add row
    int totalCount = _rows.fold(0, (sum, r) => sum + r.itemCount);
    int dbCount = widget.input.dbItemCount;

    if (dbCount - totalCount >= 1) {
      await _addRow();
    } else if (dbCount - totalCount < 0) {
      await _showAlert("Item count exceeds actual Items");
      // Reset to remaining
      int otherRowsCount = totalCount - val;
      row.itemCount = dbCount - otherRowsCount;
      if (row.itemCount < 0) row.itemCount = 0;
    }
    setState(() {});
  }

  void _onStoneChanged(AlcRow row, String value) {
    double val = double.tryParse(value) ?? 0.0;
    row.stwt = val;

    // VB Logic: Stone validation
    if (row.stwt > row.gw) {
      row.stwt = 0;
      _showAlert("Stone Weight exceeds Gross weight");
    } else {
      // Check total stone against pledge stone
      double currentStSum = _rows.fold(0.0, (sum, r) => sum + r.stwt);
      int irreg = widget.input.statusMain;
      if (irreg != 9 &&
          irreg != 10 &&
          irreg != 23 &&
          widget.input.cstwt < currentStSum) {
        row.stwt = 0;
        _showAlert("Stone Weight exceeds pledge Stone weight");
      }
    }
    _recalculate();
  }

  Future<void> _onTypeChanged(AlcRow row, int? newTypeId) async {
    if (newTypeId == null) return;
    setState(() => _isLoading = true);
    try {
      row.typeId = newTypeId;
      row.purityText = ''; // Reset purity as options change
      row.purityOptions = await widget.apiService.fetchPurityParams(
          widget.input.pledgeNo,
          widget.input.brid.toString(),
          newTypeId,
          widget.input.scheme,
          widget.input.pledgeDate);
      _recalculate();
    } finally {
      setState(() => _isLoading = false);
    }
  }

  void _handleSave() {
    // Validation
    if (_rows.isEmpty) {
      // VB: If Not String.IsNullOrEmpty(txt_totgw.Text) ...
      // If rows are empty but user wants to save, VB checks if grid has rows.
      // Here we enforce at least one row or valid totals.
      if (_totGw == 0 && _totNetwt == 0) {
        // Allow close if empty? VB says "Please fill all the items" if totals are present but grid empty?
        // Actually VB iterates rows to check if col_gw is empty.
      }
    }

    bool allFilled = true;
    for (var row in _rows) {
      if (row.gw == 0) {
        // Assuming 0 GW is invalid/empty
        allFilled = false;
        break;
      }

      if (row.purityText == '') {
        allFilled = false;
        break;
      }
    }

    if (!allFilled) {
      _showAlert("Please Enter Values or  Delete Rows to Close Form");
      return;
    }

    // VB Logic: getsubRecord
    String subrecord = "";
    for (var row in _rows) {
      double pVal = _getNumericPurityFromHeaderText(row.purityText);

      // dtstr = cItemid & "*" & ...
      String rowStr =
          "${widget.input.itemId}*${row.itemCount}*${row.gw}*${row.stwt}*${row.netwt}*${pVal.toString()}*${row.autoLoss}";

      if (subrecord.isEmpty) {
        subrecord = rowStr;
      } else {
        subrecord = "$subrecord!$rowStr";
      }
    }

    Navigator.pop(
        context,
        AlcResult(
          tGrwt: _totGw,
          tStwt: _totStwt,
          tNtwt: _totNetwt,
          subrecord: subrecord,
        ));
  }

