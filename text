      'Jan',
      'Feb',
      'Mar',
      'Apr',
      'May',
      'Jun',
      'Jul',
      'Aug',
      'Sep',
      'Oct',
      'Nov',
      'Dec'
    ];
    final dateStr =
        "${date.day.toString().padLeft(2, '0')}-${months[date.month - 1]}-${date.year}";
    final data = await _get(
        'PLP_AUDIT_SELECT', 'STONEDEDUCTION*0*0*$dateStr*$stonePct*0');
    return data.isNotEmpty
        ? (double.tryParse(data[0]['DED_PERC']?.toString() ?? '0'))
        : null;
