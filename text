  double _getNumericPurityFromHeaderText(String purityText) {
    if (purityText.isEmpty) return 0.0;
    List<String> purity = purityText.split('~');
    if (purity.isEmpty) return 0.0;
    final header = purity[0];
    List<String> spurity = [];
    if (header == "Purity Above 85(Above 20.5-ct)") {
      spurity = header.split('(');
      if (header.length >= 15) {
        spurity.add(header.substring(13, 15));
      } else {
        spurity.add("85");
      }
    } else if ([
      "Purity-70(18-ct)",
      "Purity-75(19-ct)",
      "Purity-80(20-ct)",
      "Purity-85(20.5-ct)"
    ].contains(header)) {
      spurity = header.split('(')[0].split('-');
    } else if (header.startsWith("Purity>=")) {
      spurity = header.split('=');
    } else {
      spurity = header.split('-');
      if (spurity.length == 1) {
        spurity = header.split('=');
      }
    }
    if (spurity.length > 1) {
      return double.tryParse(spurity[1].replaceAll(')', '').trim()) ?? 0.0;
    }
    return 0.0;
  }

  Future<void> _autoCalculate() async {
    await _recalculate();
    double currentGwSum = 0.0;
    double currentStSum = 0.0;
    double currentNetSum = 0.0;
    for (var row in _rows) {
      if (row.purityText.isNotEmpty && row.purityText.contains('~')) {
        currentGwSum += row.gw;
        currentStSum += row.stwt;
        currentNetSum += row.netwt;
      }
    }
    double remGw = widget.input.cgwt - currentGwSum;
    double remSt = widget.input.cstwt - currentStSum;
    double extraNet = remain_netwt(remGw, remSt);
    setState(() {
      _totGw = widget.input.cgwt;
      _totStwt = widget.input.cstwt;
      _totNetwt = currentNetSum + extraNet;
    });
    _showAlert("Auto Calculated. Remaining Net Added: $extraNet");
  }

  Future<void> _recalculate() async {
    double gwSum = 0.0;
    double stSum = 0.0;
    double netSum = 0.0;
    final rowsCopy = List<AlcRow>.from(_rows);
    for (var row in rowsCopy) {
      if (row.purityText.isEmpty || !row.purityText.contains('~')) {
        row.netwt = 0.0;
        row.estimate = 0.0;
        row.autoLoss = 0.0;
        continue;
      }
      List<String> purity = row.purityText.split('~');
      double purityVal =
          (purity.length > 1) ? (double.tryParse(purity[1]) ?? 0.0) : 0.0;
      if (purityVal >= 20 && purityVal <= 65) {
        row.estimate = (100 - ((purityVal / 87) * 100)).roundToDouble();
      } else {
        row.estimate = purityVal;
      }
      double factor = (row.estimate / 100 == 0) ? 1.0 : (row.estimate / 100);
      double clnt = ((row.gw - row.stwt) * factor);
      if (row.estimate == 0) {
        row.netwt = double.parse(clnt.toStringAsFixed(2));
      } else {
        row.netwt =
            double.parse(((row.gw - row.stwt) - clnt).toStringAsFixed(2));
      }
      if (row.netwt < 0) {
        row.netwt = 0;
        await _showAlert("Net weight cannot be negative");
      }
      double ilv = (row.cntwt * widget.input.lendRate).roundToDouble();
      double ialv = (row.netwt * widget.input.lendRate).roundToDouble();
      row.autoLoss = ilv - ialv;
    }
    for (var row in _rows) {
      gwSum += row.gw;
      stSum += row.stwt;
      netSum += row.netwt;
    }
    setState(() {
      _totGw = gwSum;
      _totStwt = stSum;
      _totNetwt = netSum;
    });
  }

  Future<void> _onItemCountChanged(AlcRow row, String value) async {
    int val = int.tryParse(value) ?? 0;
    row.itemCount = val;
    int totalCount = _rows.fold(0, (sum, r) => sum + r.itemCount);
    int dbCount = widget.input.dbItemCount;
    if (dbCount - totalCount >= 1) {
      await _addRow();
    } else if (dbCount - totalCount < 0) {
      await _showAlert("Item count exceeds actual Items");
      int otherRowsCount = totalCount - val;
      row.itemCount = dbCount - otherRowsCount;
      if (row.itemCount < 0) row.itemCount = 0;
    }
    setState(() {});
  }

  void _onStoneChanged(AlcRow row, String value) {
    double val = double.tryParse(value) ?? 0.0;
    row.stwt = val;
    if (row.stwt > row.gw) {
      row.stwt = 0;
      _showAlert("Stone Weight exceeds Gross weight");
    } else {
      double currentStSum = _rows.fold(0.0, (sum, r) => sum + r.stwt);
      int irreg = widget.input.statusMain;
      if (![9, 10, 23].contains(irreg) && widget.input.cstwt < currentStSum) {
        row.stwt = 0;
        _showAlert("Stone Weight exceeds pledge Stone weight");
      }
    }
    _recalculate();
  }

  Future<void> _onTypeChanged(AlcRow row, int? newTypeId) async {
    if (newTypeId == null) return;
    setState(() => _isLoading = true);
    try {
      row.typeId = newTypeId;
      row.purityText = '';
      row.purityOptions = await widget.apiService.fetchPurityParams(
          widget.input.pledgeNo,
          widget.input.brid.toString(),
          newTypeId,
          widget.input.scheme,
          widget.input.pledgeDate);
      _recalculate();
    } finally {
      setState(() => _isLoading = false);
    }
  }

  void _handleSave() {
    bool allFilled = _rows.every((row) => row.gw > 0 && row.purityText != '');
    if (!allFilled) {
      _showAlert("Please Enter Values or Delete Rows to Close Form");
      return;
    }
    String subrecord = _rows.map((row) {
      double pVal = _getNumericPurityFromHeaderText(row.purityText);
      return "${widget.input.itemId}*${row.itemCount}*${row.gw}*${row.stwt}*${row.netwt}*${pVal.toString()}*${row.autoLoss}";
    }).join('!');
    Navigator.pop(
        context,
        AlcResult(
          tGrwt: _totGw,
          tStwt: _totStwt,
          tNtwt: _totNetwt,
          subrecord: subrecord,
        ));
  }

