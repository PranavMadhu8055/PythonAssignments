    for (final item in data) {
      final id = item['TYPE_ID'];
      final name = item['TYPE_NAME'];
      if (id != null && name != null) {
        options[int.parse(id.toString())] = name.toString();
      }
    }
    return options;
  }

  Future<Map<int, String>> fetchStatusOptions(String brid, int stflg) async {
    final data = await _get('STATEID_CHECK', '$brid*$stflg');
    final options = <int, String>{};
    for (final item in data) {
      var id;
      var name;
      if (item is Map) {
        for (var key in item.keys) {
          if (key == '0' || key == 'STATUS_ID') id = item[key];
          if (key == "'-------SELECT---------'" || key == 'STATUS_NAME')
            name = item[key];
        }
        if (id == null && item.values.isNotEmpty) {
          final vals = item.values.toList();
          if (vals.isNotEmpty) id = vals[0];
          if (vals.length > 1) name = vals[1];
        }
      }
      if (id != null && name != null) {
        final parsedId = double.tryParse(id.toString())?.toInt();
        if (parsedId != null) {
          options[parsedId] = name.toString();
        }
      }
    }
    return options;
  }

  Future<Map<String, dynamic>?> fetchInventoryDetails(
      String brid, String pledgeNo) async {
    final data = await _get('LOAD_INV_DETAILS', '$brid*$pledgeNo');
    if (data.isNotEmpty) return data[0];
    return null;
  }
}

class _TextCell extends StatefulWidget {
  final String value;
  final ValueChanged<String> onChanged;
  final VoidCallback onSubmitted;

  const _TextCell({
    required this.value,
    required this.onChanged,
    required this.onSubmitted,
  });

  @override
  State<_TextCell> createState() => _TextCellState();
}

class _TextCellState extends State<_TextCell> {
  late TextEditingController _ctrl;

  @override
  void initState() {
    super.initState();
    _ctrl = TextEditingController(text: widget.value);
  }

  @override
  void didUpdateWidget(_TextCell oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (widget.value != oldWidget.value && widget.value != _ctrl.text) {
      _ctrl.text = widget.value;
      _ctrl.selection = TextSelection.collapsed(offset: _ctrl.text.length);
    }
  }

  @override
  void dispose() {}
  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: 160,
      child: TextField(
        controller: _ctrl,
        onChanged: widget.onChanged,
        onSubmitted: (_) => widget.onSubmitted(),
        decoration:
            const InputDecoration(isDense: true, border: OutlineInputBorder()),
      ),
    );
  }
}
